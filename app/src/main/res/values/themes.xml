<resources>
    <style name="Theme.ScheduleLink" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 起動直後のシステムのスプラッシュ画面。表示が終わるとTheme.ScheduleLinkに切り替わる。 -->
