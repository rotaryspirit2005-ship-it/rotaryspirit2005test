        <item name="windowSplashScreenBackground">@color/slatch_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ScheduleLink</item>
    </style>
</resources>
