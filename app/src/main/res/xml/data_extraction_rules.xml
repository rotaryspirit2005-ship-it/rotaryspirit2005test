<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12以降のバックアップ・端末間の移行: AIのAPIキーは端末の外へ出さない -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
